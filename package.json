{
  "name": "fabriemily",
  "version": "1.0.0",
  "description": "Web app di coppia per Fabrizio & Emily — lettere, giochi realtime, cura di animali/piante virtuali, domande e shop.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:start": "npx supabase start && npx supabase status -o env > .env.test",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --local > lib/types.ts",
    "test:int": "vitest run --config vitest.integration.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabriborgi/FabriEmily.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/fabriborgi/FabriEmily/issues"
  },
  "homepage": "https://github.com/fabriborgi/FabriEmily#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
